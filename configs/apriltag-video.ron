// AprilTag metric-anchor demo: the sample recording extracted to EuRoC layout
// (monocular, 720x1280 portrait, 30 fps). Run with
//
//   cargo run --release -p kornia-slam-app --features apriltag -- \
//     --config configs/apriltag-video.ron --no-tui
//
// The `apriltag_anchor` stage (a known 100 mm tag36h11, id 2) makes the final
// map metric after the run; it needs a build with `--features apriltag`.
// Relative paths resolve against this file's dir.
(
    source: Euroc((
        data: "../../mesh-prod/test/run1",
        start_frame: 0,
        max_frames: 0,
    )),
    system: (
        version: 1,
        sensors: ( cameras: Mono, imu: false ),
        pipeline: OrbSlam((
            apriltag_anchor: Enabled(
                tag_id: 2,
                tag_size_m: 0.1,
                family: Tag36H11,
            ),
        )),
    ),
)

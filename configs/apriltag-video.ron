// AprilTag metric-anchor demo: the sample recording extracted to EuRoC layout
// (monocular, 720x1280 portrait, 30 fps). Run with
//
//   cargo run --release -p kornia-slam-app --features apriltag -- \
//     --config configs/apriltag-video.ron --apriltag-anchor \
//     --apriltag-id 2 --apriltag-size 0.1 --apriltag-family tag36h11
//
// The system section is all defaults (monocular, no IMU); the anchor is driven
// entirely by the CLI flags. Relative paths resolve against this file's dir.
(
    source: Euroc((
        data: "../../mesh-prod/test/run1",
        start_frame: 0,
        max_frames: 0,
    )),
    system: (
        version: 1,
        sensors: ( cameras: Mono, imu: false ),
    ),
)
